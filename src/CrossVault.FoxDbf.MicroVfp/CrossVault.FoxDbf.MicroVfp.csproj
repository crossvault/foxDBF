<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1734</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.10.0</Version>
    <Authors>CrossVault</Authors>
    <Company>CrossVault</Company>
    <Description>A minimal, embeddable Visual FoxPro 9 stored-procedure interpreter: a tree-walking interpreter for real VFP9 .prg source (PROCEDURE/FUNCTION definitions, control flow incl. SCAN and FOR EACH, VFP dynamic scoping (LOCAL/PRIVATE/PUBLIC), by-value/by-reference parameter passing, ON ERROR/AERROR error handling, generalised &amp;macro execution, #DEFINE/#IF preprocessing) running against a live CrossVault.FoxDbf VfpSession - so .prg code that opens tables, seeks, scans, and writes records operates on the same byte-compatible, Rushmore-optimized engine as the rest of CrossVault.FoxDbf. Runs the data side of real business logic: LOCATE/CONTINUE navigation (full FOR/WHILE + scope, in the work area's index order, with per-area CONTINUE state), an INDEX ON TAG/TO write model (structural and non-structural .cdx, standalone .idx, SET ORDER/INDEX, REINDEX, DELETE TAG, tag introspection), REAL row/table buffering (CURSORSETPROP/CURSORGETPROP Buffering 1-5, TABLEUPDATE/TABLEREVERT, OLDVAL/CURVAL/GETFLDSTATE), SET RELATION/SET SKIP parent-child navigation, auto-firing DBC RULEs and referential-integrity triggers (== VFP9), a REAL multi-datasession model (CreateDataSession/ReleaseDataSession, SET DATASESSION TO n — isolated work areas, SETs, buffering and byte-range locks; ASESSIONS/AUSED), low-level file I/O (the FOPEN/FREAD/FWRITE/FSEEK/FCLOSE family, FILETOSTR/STRTOFILE, ADIR), and a broad runtime function library (string/date/math incl. the ...C string-function variants with single-byte-code-page semantics, arrays, TRANSFORM/VARTYPE/STRCONV/TEXTMERGE, session &amp; index introspection). For running real-world VFP9 business-logic stored procedures on .NET without a Visual FoxPro installation. Note the honest limit: RLOCK/LOCK/FLOCK/UNLOCK/ISRLOCKED/ISFLOCKED take REAL VFP-byte-compatible byte-range locks (honouring SET REPROCESS/MULTILOCKS) so a stored proc coordinating via RLOCK is mutually exclusive with a concurrent VFP client, only the SET REPROCESS TO ... SECONDS wait timing is approximated.</Description>
    <PackageTags>foxpro;visualfoxpro;vfp;prg;interpreter;stored-procedure;dsl;xbase</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- CrossVault.FoxDbf.Sql was merged into CrossVault.FoxDbf (same package now, no cycle since
         VfpSession/SqlParser live there); reference Core directly for a normal nuspec dependency. -->
    <ProjectReference Include="..\CrossVault.FoxDbf\CrossVault.FoxDbf.csproj" />
    <ProjectReference Include="..\CrossVault.FoxDbf.Expressions\CrossVault.FoxDbf.Expressions.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrossVault.FoxDbf.Tests.Public" />
    <InternalsVisibleTo Include="CrossVault.FoxDbf.Tests.Internal" />
    <!-- The ADO.NET provider reads interpreter state (Memory) for SP results/EnforceRules; the
         interpreter internals are deliberately NOT public API (finding 5.11) - same sibling-IVT
         pattern Core already uses for Data. DECIDED (review finding 5.12, 2026-07-03): the hard
         Data->MicroVfp dependency is DELIBERATE (the interpreter is core product value, SP calls +
         EnforceRules work out of the box); no separate adapter package. -->
    <InternalsVisibleTo Include="CrossVault.FoxDbf.Data" />
  </ItemGroup>

</Project>
