<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1734</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CrossVault.FoxDbf.Data</PackageId>
    <Version>0.10.0</Version>
    <Authors>CrossVault</Authors>
    <Company>CrossVault</Company>
    <Description>ADO.NET data provider for Visual FoxPro / dBase tables and database containers, built on CrossVault.FoxDbf. Use FoxPro/dBase data from Dapper, raw ADO.NET, reporting, and LINQPad via SQL: FoxDbfConnection / FoxDbfCommand / FoxDbfDataReader / FoxDbfParameter / FoxDbfConnectionStringBuilder / FoxDbfProviderFactory, plus FoxDbfDataSource (the modern DbDataSource factory for DI) and FoxDbfBatch (DbBatch). Connection string mirrors the VFP OLE DB Provider (Data Source = .dbc | directory | .dbf; Collate; Exclusive; Deleted; Ansi; ReadOnly; Accelerator=Highlike; EnforceRules/EnforceRI). Supports SELECT (INNER/LEFT/RIGHT/FULL JOIN, UNION, correlated subqueries, GROUP BY, aggregates, ORDER BY, TOP, INTO CURSOR/TABLE/ARRAY), INSERT/UPDATE/DELETE (incl. INSERT FROM ARRAY/MEMVAR and SELECT INTO ARRAY landing in the connection's active data session with _TALLY), CREATE/ALTER/DROP TABLE, the VFP work-area model (USE/SELECT), positional ? and named @/: parameters, real transactions (atomic rollback), DataAdapter/CommandBuilder, GetSchema metadata, and a static DBF-header type map. Runs a .dbc's stored procedures / UDFs via CommandType.StoredProcedure (and ad-hoc "?expr"/"=expr" evaluation) on the embedded microVFP interpreter; with the opt-in EnforceRules (alias EnforceRI) connection keyword and a .dbc open, INSERT/UPDATE/DELETE run the full VFP write model (field DEFAULTs, then field RULEs, NOT NULL/type/width, the record RULE, unique/candidate/primary-key, and finally the bound RI trigger) atomically — exactly like VFP9 (default OFF = raw DML, byte-for-byte unchanged). Output is byte-compatible with the real Visual FoxPro 9 runtime.</Description>
    <PackageTags>foxpro;visualfoxpro;dbf;dbc;ado.net;adonet;dbprovider;sql;dapper;xbase;dbase</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrossVault.FoxDbf.Tests.Public" />
    <InternalsVisibleTo Include="CrossVault.FoxDbf.Tests.Internal" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sql and Highlike were merged into CrossVault.FoxDbf (one package now: core + SQL + opt-in
         accelerator). Reference Core directly — normal reference, so `dotnet pack` emits a real
         nuspec dependency on the published CrossVault.FoxDbf package. -->
    <ProjectReference Include="..\CrossVault.FoxDbf\CrossVault.FoxDbf.csproj" />
    <!-- microVFP interpreter: the provider runs stored procedures / UDFs and (opt-in EnforceRules)
         enforces the DBC's DEFAULT/RULE/TRIGGER on writes through it. Normal reference -> nuspec
         dependency on the published CrossVault.FoxDbf.MicroVfp package. -->
    <ProjectReference Include="..\CrossVault.FoxDbf.MicroVfp\CrossVault.FoxDbf.MicroVfp.csproj" />
    <!-- Data uses Expressions types directly (IVfpCollation/EvaluationContext in the conn-string
         mapping). Expressions is bundled in the Core package (no standalone package), so reference it
         compile-time only — PrivateAssets="all" — no NuGet dependency; the DLL arrives via Core. -->
    <ProjectReference Include="..\CrossVault.FoxDbf.Expressions\CrossVault.FoxDbf.Expressions.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
